# Supabase — get these from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — never expose to browser

# JWT — generate a strong random string, e.g.: openssl rand -base64 32
JWT_SECRET=your-jwt-secret

# Google Books API — https://console.cloud.google.com → Enable "Books API" → Create API key
# Free tier: 1000 requests/day, no credit card required
GOOGLE_BOOKS_API_KEY=your-google-books-api-key
